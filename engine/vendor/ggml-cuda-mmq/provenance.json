    {
      "id": "V-MV1",
      "description": "Trim mmvq to a device-only, error-returning MMVQ for Q4_K, Q5_0, Q6_K and Q8_0 (MATVEC-PAR S1): the ggml_tensor host entries are removed and replaced by fifi_mmvq_launch over fifi_mmvq_args (device facts from the caller, V-3b pattern); every assert and abort on the launch path returns cudaErrorInvalidValue or cudaErrorNotSupported and ggml_cuda_kernel_launch results are returned; the type switch keeps only the four formats; the ids path guards the per-slot expert id against the stack range and writes a quiet NaN for an out-of-range id, reading no weight (KUBDAN-MSG-62 A1); ggml_cuda_mm_fusion_args_device is restored into mmvq.cuh; no PDL; the dense-view fastdiv precondition is checked only when ids is null (the ids path passes zeros, and fastdiv_valid(0) is false); fifi_mmvq_launch also refuses ncols_x < 1 and an ids launch with more than one column (the multi-column ids kernel is not wrapped in S1)",
      "diff": "patches/V-MV1-mmvq.patch",
      "files": {
        "src/ggml-cuda/mmvq.cu": {
          "before_sha256": "d4c70f68ab79d463fd6fd52cac66a62e915858397ba4b2b7f658a7fbf13121f3",
          "after_sha256": "8ffa0a71dd8e9a0ca1931f455d007d1e0a0f9190d9ba6a9c649598e4d6a82d9d"
        },
        "src/ggml-cuda/mmvq.cuh": {
          "before_sha256": "b37f8359f519ba90ddecd9cb3ca5f8c2ae05685bfae6813d435d75763c2bb006",
          "after_sha256": "d10e0201283eff3bbbe6e2d9f3cfc813a7af507547f55f79ad6359520e49d317"
        }
      }
    },
    {
