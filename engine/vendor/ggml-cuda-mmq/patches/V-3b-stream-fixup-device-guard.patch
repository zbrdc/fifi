+// V-3b: the device facts the MMQ code reads. Our context fills them for the device it launches on; they replace
+// ggml_cuda_info().devices[ggml_cuda_get_device()] and the ggml backend context.
+// cc is ggml's internal encoding, 100 * major + 10 * minor (720 for sm_72, 860 for sm_86), not the CUDA major * 10 + minor.
+struct fifi_device_facts {
+    int    device; // CUDA device ordinal, below GGML_CUDA_MAX_DEVICES
+    int    cc;     // 100 * major + 10 * minor
+    int    nsm;    // number of streaming multiprocessors
+    size_t smpbo;  // max. shared memory per block with opt-in, in bytes
+};
+
+// V-3b: the host refuses a launch, before it touches the device, when the device is not one the objects were built for
+// (KUBDAN-MSG-39 Q3). The kernels exist for the architectures of __CUDA_ARCH_LIST__ (sm_72 and sm_86 in this engine).
+// A zeroed or unfilled fifi_device_facts (cc 0), an architecture that was not built (say 890) or nsm 0 would otherwise pick a
+// tile table the device code does not match, divide by zero, or reach no_device_code, which does nothing.
+static bool fifi_arch_built(const int cc) {
+#ifdef __CUDA_ARCH_LIST__
+    return ggml_cuda_has_arch(cc);
+#else
+    return cc >= GGML_CUDA_CC_VOLTA;
+#endif // __CUDA_ARCH_LIST__
+}
+
+#define FIFI_MIN_SMPBO (48 * 1024) // every device built for has at least the default 48 KiB per block
+
+static cudaError_t fifi_check_device(const fifi_device_facts & dev) {
+    FIFI_REQUIRE(dev.device >= 0 && dev.device < GGML_CUDA_MAX_DEVICES);
+    FIFI_REQUIRE(fifi_arch_built(dev.cc));
+    FIFI_REQUIRE(dev.nsm > 0);
+    FIFI_REQUIRE(dev.smpbo >= FIFI_MIN_SMPBO);
+    return cudaSuccess;
+}
 
